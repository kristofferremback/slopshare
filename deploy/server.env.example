# Copy to ~/.config/slopshare/server.env
# Browser origin: `tailscale serve --bg --https=20160 http://127.0.0.1:20160`
SLOPSHARE_PUBLIC_URL=https://homelab.your-tailnet.ts.net:20160
SLOPSHARE_WEB_PORT=20160
# Bound on this machine's tailnet IPv4 address
SLOPSHARE_AGENT_PORT=20161
# The only Tailscale login allowed to open pages and create slots
SLOPSHARE_ALLOWED_LOGIN=you@example.com
# MagicDNS host names allowed to create and collect slots
SLOPSHARE_ALLOWED_NODES=homelab,laptop
